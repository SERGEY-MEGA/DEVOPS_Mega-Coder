{
  "dashboard": {
    "id": null,
    "uid": "mega-coder-devops",
    "title": "MEGA CODER / DevOps Overview",
    "tags": ["mega-coder", "devops", "course"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "CPU used, %",
        "description": "Node Exporter metric: показывает загрузку CPU на сервере.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "refId": "A",
            "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
            "legendFormat": "cpu"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2
          },
          "overrides": []
        },
        "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Memory available, %",
        "description": "Node Exporter metric: сколько RAM свободно/доступно.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "refId": "A",
            "expr": "(node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
            "legendFormat": "memory"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2
          },
          "overrides": []
        },
        "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Disk available, GB",
        "description": "Node Exporter metric: свободное место на корневом разделе.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "refId": "A",
            "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / 1024 / 1024 / 1024",
            "legendFormat": "disk"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decgbytes",
            "decimals": 1
          },
          "overrides": []
        },
        "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Pods in mega-coder",
        "description": "kube-state-metrics: количество pod'ов приложения в namespace mega-coder.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "refId": "A",
            "expr": "count(kube_pod_info{namespace=\"mega-coder\"})",
            "legendFormat": "pods"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0
          },
          "overrides": []
        },
        "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Network receive rate",
        "description": "Node Exporter metric: входящий сетевой трафик без loopback-интерфейса.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))",
            "legendFormat": "receive bytes/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps"
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 }
      },
      {
        "id": 6,
        "type": "table",
        "title": "Deployment available replicas",
        "description": "kube-state-metrics: доступные реплики deployment'ов приложения.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "refId": "A",
            "expr": "kube_deployment_status_replicas_available{namespace=\"mega-coder\"}",
            "format": "table",
            "instant": true
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 }
      },
      {
        "id": 7,
        "type": "logs",
        "title": "Application logs from Loki",
        "description": "Loki + Promtail: логи контейнеров api, web и worker из namespace mega-coder.",
        "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
        "targets": [
          {
            "refId": "A",
            "expr": "{namespace=\"mega-coder\"}"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": true,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": true
        },
        "gridPos": { "h": 11, "w": 24, "x": 0, "y": 13 }
      }
    ]
  },
  "overwrite": true
}
